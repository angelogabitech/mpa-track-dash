# Lovable Cloud / Supabase environment variables
# These are auto-provisioned by Lovable Cloud and stored in .env
# When migrating to your own Supabase project, replace with your own values:

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
